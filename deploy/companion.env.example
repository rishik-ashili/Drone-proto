# /etc/gdnav/companion.env
GDNAV_PX4_URL=serial:///dev/ttyAMA0:921600   # Pi UART to Pixhawk TELEM2 (Jetson: /dev/ttyTHS1)
GDNAV_MISSION=plan_example
GDNAV_CAMERA=0                                # /dev/video0
GDNAV_NAV_SOURCE=flow                         # ROS service only: flow | vio
GDNAV_PX4_PORT=/dev/ttyTHS1                   # ROS service only
